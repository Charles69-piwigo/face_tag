/*============================================================*/
/* BOUTONS FACE TAG - Styles minimaux pour compatibilité thèmes */
/*============================================================*/

/* Laisser le thème gérer l'alignement des boutons via .pwg-button */
/* On applique uniquement les styles spécifiques aux icônes */

/* Style des icônes XMP et Faces */
#facetag_show_xmp img,
#facetag_show_faces img {
  filter: invert(100%);
  border-radius: 3px;
  width: 22px;
  height: 22px;
  padding: 2px;
  vertical-align: middle;
}

/* État ACTIF du bouton Faces */
#facetag_show_faces.facetag-active {
  background-color: transparent !important; /* Pas de fond sur le bouton */
}

/* Fond vert uniquement sur l'icône en état actif */
#facetag_show_faces.facetag-active img {
  filter: invert(65%) sepia(53%) saturate(422%) hue-rotate(75deg) brightness(95%) contrast(87%) !important;
  background-color: rgba(76, 175, 80, 0.8) !important;
  border-radius: 4px;
  padding: 3px;
}

/*============================================================*/
/* CONTAINER ET OVERLAYS DES VISAGES */
/*============================================================*/

/* Container principal */
.facetag-wrapper {
  text-align: center;
  width: 100%;
  overflow: hidden;
}

.facetag-container {
  position: relative !important;
  display: inline-block !important;
  margin: 0 auto !important;
  padding: 0 !important;
  line-height: 0 !important;
  max-width: 100% !important;
}

.facetag-container img {
  display: block !important;
  max-width: 100% !important;
  height: auto !important;
}

/* Rectangles des visages */
.facetag-overlay {
  position: absolute;
  border: 3px solid #00ff00;
  box-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
  pointer-events: none;
  z-index: 1000;
  box-sizing: border-box;
  opacity: 1;
}

/* Labels des noms */
.facetag-label {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.9);
  color: white;
  padding: 0.3em 0.7em;
  border-radius: 3px;
  font-size: 13px;
  font-weight: normal;
  white-space: nowrap;
  pointer-events: none;
  margin-top: 3px;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  z-index: 1001;
}